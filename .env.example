# Copy this file to .env and fill in your Azure-hosted Claude settings.
# .env is ignored by git.

CLAUDE_API_ENDPOINT=https://your-resource-name.services.ai.azure.com/models
CLAUDE_API_KEY=replace-with-your-key
CLAUDE_MODEL=claude-3-5-sonnet
CLAUDE_API_VERSION=2024-05-01-preview

# Optional local SQLite path. Defaults to data/helpdesk.db.
HELPDESK_DB_PATH=data/helpdesk.db
